---
import '../styles/global.css';
import '../styles/pages.css';
const {title = 'KindDesign – Et kreativt fællesskab', description = 'KindDesign er et kreativt fællesskab for alle slags designere. Mød andre kreative og find dit fællesskab.', inner = false, version = 'v2'} = Astro.props;
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/webp" href="/images/af5ee.webp" />
    <link rel="preload" href="/fonts/bricolage-variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-variable.ttf" as="font" type="font/ttf" crossorigin />
    <title>{title}</title>
  </head>
  <body class:list={[inner && "inner-page", inner && `version-${version}`]}>
    <a class="skip-link" href="#indhold">Spring til indhold</a>
    <slot />
  </body>
</html>
