---
import InnerLayout from '../components/InnerLayout.astro';
import PageHero from '../components/PageHero.astro';
const founders = [
 {name:'Julia Kulbaczewska',desktop:'Julia foreslog i marts 2025 at skabe et fællesskab for kreative og designere. Sammen med Jeremy har hun udviklet idéen til KindDesign.',mobile:'Julia er medstifter af KindDesign. I et offentligt opslag beskriver Jeremy, hvordan Julia i marts 2025 foreslog at skabe et fællesskab for designere og kreative. Sammen har de udviklet initiativet til et sted, hvor mennesker kan mødes og dele deres interesse for design.'},
 {name:'Jeremy Bohdan',desktop:'Jeremy er medstifter af KindDesign. Han beskriver fællesskabet som et passionsprojekt drevet af design, kreativitet og forbindelser.',mobile:'Jeremy er medstifter af KindDesign. Han beskriver fællesskabet som et passionsprojekt ved siden af deres øvrige arbejde, drevet af glæden ved design og kreativitet. Hans offentlige opslag fortæller om ambitionen om at forbinde mennesker og skabe rum for inspiration og udveksling.'}
];
const values = [ ['Nysgerrighed','Vi mødes for at lære, udforske og dele perspektiver.','Vi mødes for at lære og dele perspektiver.'],['Fællesskab','Et åbent rum for kreative mennesker.','Plads til mennesker med en fælles interesse for design.'],['Inspiration','Vi deler idéer og erfaringer på tværs.','Idéer vokser, når vi deler dem.'] ];
---
<InnerLayout description="Mennesker, idéer og design i fællesskab. Læs om menneskene bag KindDesign." title="Om KindDesign">
  <PageHero title="OM KINDDESIGN" subtitle="Mennesker, idéer og design i fællesskab." about />
  <section class="about-section">
    <div class="about-intro"><h2>DESIGN OPSTÅR<br class="desktop-label" /> MELLEM MENNESKER.</h2><p><span class="desktop-label">KindDesign er et kreativt fællesskab i København, hvor designere og andre kreative mødes for at dele idéer, blive inspireret og skabe nye forbindelser.</span><span class="mobile-label">KindDesign er et fællesskab for designere og kreative, som mødes, skaber forbindelser og deler idéer.</span></p></div>
    <div class="founders"><div class="founders-intro"><p class="eyebrow">MØD FOUNDERNE</p><h2>Menneskene<br class="desktop-label" /> bag KindDesign.</h2><p class="desktop-label">KindDesign er startet af Julia Kulbaczewska og Jeremy Bohdan, der deler en interesse for design, fællesskab og samtaler mellem kreative mennesker.</p></div>{founders.map(founder => <article class="founder"><div class="portrait-placeholder">PORTRÆT AFVENTER<br /> BRUGSTILLADELSE</div><h3>{founder.name}</h3><p class="founder-role">CO-FOUNDER · KINDDESIGN</p><p class="desktop-label">{founder.desktop}</p><p class="mobile-label">{founder.mobile}</p></article>)}</div>
    <div class="story-banner"><picture><source media="(max-width:600px)" srcset="/images/0bb08-640.webp" /><img src="/images/d2848.webp" srcset="/images/d2848-680.webp 680w, /images/d2848.webp 1400w" sizes="50vw" width="674" height="360" alt="Deltagere deler idéer hos KindDesign" loading="lazy" /></picture><div><p class="eyebrow desktop-label">HVORFOR KINDDESIGN?</p><h2>Fra en idé til et<br class="desktop-label" /> kreativt fællesskab.</h2><p><span class="desktop-label">Idéen opstod i marts 2025 som et fællesskab for kreative og designere. Et sted at dele idéer, skabe forbindelser og inspirere hinanden.</span><span class="mobile-label">I marts 2025 opstod idéen om et fællesskab for kreative og designere. Julia og Jeremy har siden skabt meetups og talks med plads til nye forbindelser og inspiration.</span></p></div></div>
    <div class="values"><div><p class="eyebrow desktop-label">VORES VÆRDIER</p><h2>Det, der samler os.</h2></div>{values.map(([title,description,mobileDescription]) => <article><span aria-hidden="true" class="desktop-label">✧</span><h3>{title}</h3><p><span class="desktop-label">{description}</span><span class="mobile-label">{mobileDescription} · Redaktionelt værdiforslag til godkendelse.</span></p></article>)}</div>
    <div class="mobile-about-actions"><a class="button" href="/events/">Find et event ↗</a><a class="button" href="/ny-her/">Ny her? ↗</a></div>
  </section>
</InnerLayout>
