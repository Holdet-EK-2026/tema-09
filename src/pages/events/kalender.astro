---
import InnerLayout from '../../components/InnerLayout.astro';
import {officialEvents,nextEvent} from '../../data/events.js';
const now = new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Copenhagen',year:'numeric',month:'2-digit'}).format(new Date());
const currentMonth = now.replaceAll('/','-');
const months = [...new Set([currentMonth,...officialEvents.map(event=>event.date.slice(0,7))])].sort().reverse().map(value=>{
  const [year,month]=value.split('-').map(Number);
  const offset=(new Date(Date.UTC(year,month-1,1)).getUTCDay()+6)%7;
  const count=new Date(Date.UTC(year,month,0)).getUTCDate();
  return {value,label:new Intl.DateTimeFormat('da-DK',{month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(Date.UTC(year,month-1,1))),days:Array.from({length:42},(_,index)=>index>=offset&&index<offset+count?index-offset+1:null)};
});
---
<InnerLayout title="Eventkalender" description="KindDesigns officielle events i kalenderen med lokale tidszoner og links til eventdetaljer." version="legacy">

  <section class="calendar-heading"><h1>FIND DIT NÆSTE “VI SES”.</h1><p>Vælg en måned og find KindDesigns officielle meetups, talks og workshops.</p></section>
  <section class="calendar-section"><nav class="calendar-tabs" aria-label="Eventvisning"><a href="/events/?status=all">Alle events</a><a href="/events/?type=Meetup">Meetups</a><a href="/events/?type=Workshop">Workshops</a><a href="/events/?type=Talk">Talks</a><a href="/events/kalender/" aria-current="page">Kalender</a></nav><div class="calendar-month-control"><label for="calendar-month">Vælg måned</label><select id="calendar-month" disabled>{months.map(month=><option value={month.value} selected={month.value===currentMonth}>{month.label}</option>)}</select><noscript><p>Uden JavaScript vises den aktuelle måned. Se alle arrangementer på Events-siden.</p></noscript></div>
  {months.map(month=><div data-calendar-month={month.value} hidden={month.value!==currentMonth}><h2>{month.label}</h2><div class="calendar-grid" role="table" aria-label={month.label}><div role="row" class="calendar-weekdays">{['MAN','TIR','ONS','TOR','FRE','LØR','SØN'].map(day=><span role="columnheader">{day}</span>)}</div>{Array.from({length:6},(_,week)=><div role="row" class="calendar-week">{month.days.slice(week*7,week*7+7).map(day=>{const event=officialEvents.find(event=>event.date===`${month.value}-${String(day).padStart(2,'0')}`);return <div role="cell" class:list={[day&&'calendar-day',event&&'has-event']}>{event?<a data-event-link href={`/events/${event.slug}/`} aria-label={`${event.dateLabel}: ${event.title}${event.status==='past'?', afsluttet':''}`}>{day}<span>{event.type}</span></a>:day}</div>})}</div>)}</div></div>)}
  <p class="calendar-source">Datoer følger eventets lokale tidszone. <a href="https://luma.com/user/kinddesign">Se den officielle Luma-profil ↗</a>.</p></section>
  <section class="calendar-editorial official-calendar" data-official-event data-event-end={nextEvent?.endAt} data-event-status={nextEvent?.status}><div><h2 data-event-status-label>Næste verificerede event.</h2>{nextEvent ? <><a data-event-link href={`/events/${nextEvent.slug}/`} class="calendar-feature"><img src={`/images/luma-${nextEvent.id}-600.webp`} srcset={`/images/luma-${nextEvent.id}-450.webp 450w, /images/luma-${nextEvent.id}-600.webp 600w, /images/luma-${nextEvent.id}-1200.webp ${nextEvent.coverWidth}w`} sizes="(max-width:600px) calc(100vw - 48px), 55vw" width="846" height="330" alt={`Officielt cover: ${nextEvent.title}`} fetchpriority="high" /></a><h3 class="calendar-feature-title"><a data-event-link href={`/events/${nextEvent.slug}/`}>{nextEvent.title} ↗</a></h3><p>{nextEvent.dateLabel} · {nextEvent.time}<br />{nextEvent.city} · {nextEvent.timezone} · lokal tid</p></> : <p>Der er ingen verificerede kommende events i det lokale katalog. Se <a href="https://luma.com/user/kinddesign">KindDesign på Luma ↗</a>.</p>}</div><img class="calendar-portrait" src="/images/1207b.webp" width="415" height="700" alt="KindDesigns kreative fællesskab" /></section>
  <aside class="calendar-collaboration"><h2>Skal vi skabe noget sammen?</h2><a class="button" href="/kontakt/?emne=Samarbejde">Foreslå et samarbejde</a></aside>
</InnerLayout>
<script src="../../scripts/calendar.js"></script>

<script src="../../scripts/event-status.js"></script>
