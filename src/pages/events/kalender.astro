---
import InnerLayout from '../../components/InnerLayout.astro';
import {listedEvents} from '../../data/events.js';
const days = Array.from({length:42},(_,index)=>index<6 || index>35?null:index-5);
---
<InnerLayout title="Eventkalender" version="legacy">
  <section class="calendar-editorial"><div><h1>FIND DIT NÆSTE<br /> “VI SES”.</h1><p class="eyebrow">MEETUPS, TALKS OG WORKSHOPS / ALLE SLAGS DESIGNERE.</p><a href="/events/design-og-nye-forbindelser/" class="calendar-feature"><img src="/images/ca544.webp" width="846" height="330" alt="To kreative deltagere til et KindDesign-arrangement" /><strong>NYE FORBINDELSER</strong></a><p>NÆSTE MEETUP / 12. NOVEMBER · 18.00<br /> Design &amp; nye forbindelser ↗ · DEMO</p></div><img class="calendar-portrait" src="/images/1207b.webp" width="415" height="700" alt="Deltagere i KindDesigns fællesskab" /></section>
  <section class="calendar-section"><nav class="calendar-tabs" aria-label="Eventvisning"><a href="/events/">Alle events</a><a href="/events/?type=Meetup">Meetups</a><a href="/events/?type=Workshop">Workshops</a><a href="/events/?type=Talk">Talks</a><a href="/events/kalender/" aria-current="page">Kalender</a></nav><h2>November 2026</h2><div class="calendar-grid" role="table" aria-label="November 2026, eksempelprogram"><div role="row" class="calendar-weekdays">{['MAN','TIR','ONS','TOR','FRE','LØR','SØN'].map(day=><span role="columnheader">{day}</span>)}</div>{Array.from({length:6},(_,week)=><div role="row" class="calendar-week">{days.slice(week*7,week*7+7).map(day=>{const event=listedEvents.find(event=>event.day===day);return <div role="cell" class:list={[day && 'calendar-day',event && 'has-event']}>{event?<a href={`/events/${event.slug}/`} aria-label={`${day}. november: ${event.title}`}>{day}<span>{event.type}</span></a>:day}</div>})}</div>)}</div></section>
  <aside class="calendar-collaboration"><h2>Skal vi skabe noget sammen?</h2><a class="button" href="/kontakt/?emne=Samarbejde">Foreslå et samarbejde</a><a class="button" href="/ny-her/#medlemskort">Se dit digitale medlemskort</a></aside>
</InnerLayout>
