---
import InnerLayout from '../../components/InnerLayout.astro';
import {events} from '../../data/events.js';
export function getStaticPaths() {return events.map(event => ({params:{slug:event.slug},props:{event}}));}
const {event} = Astro.props;
const first = event.slug === 'design-og-nye-forbindelser';
const program = [[event.start.replace(':','.'),'Velkommen – find dig til rette'],['18.15','En kort præsentationsrunde'],['18.45','Pause og noget at drikke'],['19.00','Kreativ øvelse og frie samtaler'],[event.end.replace(':','.'),'Tak for i aften']];
---
<InnerLayout title={event.title} description={event.description} version="legacy">
  <section class="event-detail-hero"><a class="back-link" href="/events/">← ALLE EVENTS</a><p class="detail-type">{event.type.toUpperCase()} / EKSEMPELEVENT{!first && event.type !== 'Meetup' ? ' · COMMUNITYFOTO' : ''}</p><h1>{event.title}</h1><p class="detail-description">Mød andre kreative, del det, du er optaget af, og vær nysgerrig på hinandens perspektiver.</p><p class="detail-date">{event.day}. {event.month.toUpperCase()} 2026 / {event.time}</p><p class="detail-location">KØBENHAVN · STED BEKRÆFTES</p><div class="detail-actions"><a class="button" href={event.lumaUrl || `/tilmelding/${event.slug}/`}>{event.lumaUrl ? 'Tilmeld dig via Luma ↗' : 'Tilmelding / demo ↗'}</a><a class="button secondary" href={`/kalender/${event.slug}/`}>Tilføj til kalender</a></div><img src={`/images/${event.detailImage}.webp`} srcset={`/images/${event.detailImage}-700.webp 700w, /images/${event.detailImage}.webp 1400w`} sizes="(max-width:600px) 550px, (max-width:1250px) 60vw, 830px" width="520" height="550" alt="Communityfoto fra et KindDesign-arrangement" fetchpriority="high" /></section>
  <section class:list={['event-program',first && 'first-event-program']}><h2>En aften i godt selskab.</h2><div class="program-grid"><ol>{program.map(([time,label])=><li><time>{time}</time><span>{label}</span></li>)}</ol><div class="program-invitation">{first && <img src="/images/ca544.webp" srcset="/images/ca544-500.webp 500w, /images/ca544.webp 1000w" sizes="(max-width:600px) calc(100vw - 48px), 576px" width="576" height="280" alt="To deltagere i samtale" loading="lazy" />}<h2>Et fælles emne.<br /> Et første hej.<br /> En ny samtale.</h2><a class="button" href="/ny-her/">Er du ny her?</a></div></div></section>
  <section class="event-practical"><div class="practical-card"><img src="/images/acf24.webp" width="480" height="470" alt="Deltagere i KindDesigns kreative fællesskab" loading="lazy" /><div><p class="eyebrow">DIN FØRSTE SAMTALE</p><h2>Tag din nysgerrighed med.</h2><p>Hvad arbejder du på lige nu? Hvad har overrasket dig, og hvad vil du gerne lære? Du behøver ikke have alle svarene for at bidrage til en god samtale.</p><p>Fortæl om en idé, der stadig er undervejs, eller spørg ind til en andens erfaring. Det fælles emne kan gøre det lettere at tage det første hej videre.</p><aside id="praktisk"><p class="eyebrow">KØBENHAVN</p><p>Venue og præcis adresse offentliggøres med eventet.</p><a class="button" href={`/kalender/${event.slug}/`}>Se praktisk information</a></aside></div></div><p class="prototype-note">Dato, venue, værtsnavn og tilmelding er eksempelindhold til prototypen.</p></section>
</InnerLayout>
