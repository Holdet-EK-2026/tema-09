---
import '../styles/global.css';
import '../styles/carousel.css';
// Originale, uforvrængede KindDesign-fotos. CSS skaber perspektivet i stedet for billedet.
const photos = [
  ['3c8b7', 'Deltagere omkring et bord ved et KindDesign-arrangement'],
  ['1207b', 'To deltagere ved et KindDesign-arrangement'],
  ['0bb08', 'Deltagere i samtale hos KindDesign'],
  ['c149a', 'En deltager fortæller ved et KindDesign-arrangement'],
  ['d2848', 'En samtale omkring et bord'],
  ['ca544', 'To deltagere i KindDesigns fællesskab'],
];
---
<section class="gallery-section" aria-labelledby="gallery-title" data-carousel>
  <div class="gallery-intro">
    <h2 id="gallery-title">FÆLLES NYSGERRIGHED.<br />NYE FORBINDELSER.</h2>
    <p>Design giver os noget at mødes om. Samtalerne giver os mulighed for at lære hinanden at kende. Her kan du dele din nysgerrighed, møde andre kreative og opdage nye perspektiver. Et event kan være dit første møde med KindDesign. Fællesskabet er det, vi bygger videre på sammen.</p>
  </div>
  <div class="gallery-window" tabindex="0" role="region" aria-roledescription="billedkarrusel" aria-label="Billeder fra KindDesigns fællesskab" aria-describedby="carousel-instructions">
    <div class="gallery-track">
      {photos.map(([photo, description], index) => <figure class="gallery-card" role="group" aria-roledescription="slide" aria-label={`Billede ${index + 1} af ${photos.length}`}>
        <img draggable="false" src={index===0?`/images/gallery-${photo}-600.webp`:undefined} data-gallery-source={`/images/gallery-${photo}-600.webp`} data-gallery-srcset={`/images/gallery-${photo}-600.webp 600w, /images/gallery-${photo}-1600.webp 1600w`} sizes={["3c8b7","0bb08","c149a"].includes(photo) ? "(max-width:600px) 480px, (max-width:900px) 660px, 780px" : "(max-width:600px) 280px, (max-width:900px) 300px, 360px"} alt={description} width="360" height="480" loading="lazy" fetchpriority="low" />
        <noscript><img src={`/images/gallery-${photo}-600.webp`} srcset={`/images/gallery-${photo}-600.webp 600w, /images/gallery-${photo}-1600.webp 1600w`} sizes="(max-width:600px) 480px, 780px" alt={description} width="360" height="480" loading="lazy" /></noscript>
        <figcaption><span>KindDesign</span><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></figcaption>
      </figure>)}
    </div>
    <div class="carousel-tools" role="group" aria-label="Styr billedkarrusellen" hidden>
      <button type="button" data-carousel-previous aria-label="Forrige billede"><span aria-hidden="true">←</span></button>
      <span class="carousel-position" aria-hidden="true" data-carousel-position>1 / {photos.length}</span>
      <button type="button" data-carousel-next aria-label="Næste billede"><span aria-hidden="true">→</span></button>
      <button class="carousel-toggle" type="button" data-carousel-toggle aria-label="Sæt automatiske billedskift på pause"><span data-carousel-toggle-label>Pause</span></button>
    </div>
  </div>
  <p id="carousel-instructions" class="sr-only">Brug venstre og højre piletast, eller swipe mellem billederne. Billederne bevæger sig kontinuerligt. Tryk mellemrum for at sætte bevægelsen på pause eller genoptage den. Pile og swipe stopper automatikken; vælg Afspil for at fortsætte.</p>
  <span class="sr-only" role="status" aria-atomic="true" data-carousel-status></span>
</section>
<noscript><style is:inline>.gallery-card > img[data-gallery-source] { display: none; }</style></noscript>
<script src="../scripts/carousel.js"></script>
