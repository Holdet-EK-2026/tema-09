---
import {publishedEvents} from "../lib/event-repository.js";
const {events}=await publishedEvents();
const nextEvent=events.filter(e=>e.status==='upcoming').sort((a,b)=>new Date(a.startAt)-new Date(b.startAt))[0];
---
<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-photo">
    <source media="(max-width: 600px)" srcset="/images/1207b-600.webp 600w, /images/1207b.webp 780w, /images/1207b-1200.webp 1200w" sizes="600px" />
    <source media="(min-width: 601px)" srcset="/images/0bb08-1600-optimized.webp 1600w, /images/0bb08-2880-optimized.webp 2880w" sizes="100vw" />
    <img src="/images/0bb08-2880-optimized.webp" width="1440" height="1000" alt="Kreative deltagere i samtale ved et KindDesign-arrangement" fetchpriority="high" />
  </picture>
  <div class="hero-shade"></div>
  <div class="hero-intro">
    <h1 id="hero-title"><span>KIND</span> <span>DESIGN</span></h1>
    <p class="hero-tagline"><span>Mød andre kreative.</span> <span>Find dit fællesskab.</span></p>
    <a class="button hero-cta" href="/events/">Find dit næste event<span class="desktop-label">&nbsp;</span> ↗</a>


  </div>
  <div class="hero-details">
    <div class="hero-event-summary">
  <p class="hero-community">ET KREATIVT FÆLLESSKAB<br />FOR ALLE SLAGS DESIGNERE</p>
  {nextEvent && <a class="hero-event" href={`/events/${nextEvent.slug}/`}>NÆSTE EVENT / {nextEvent.day}. {nextEvent.month.toUpperCase()} · {nextEvent.city.toUpperCase()}<br />{nextEvent.title}</a>}
    </div>
    {nextEvent ? <a class="countdown" href={`/events/${nextEvent.slug}/`} data-event-countdown data-start-at={nextEvent.startAt} data-end-at={nextEvent.endAt} aria-description={`Tid til eventet ${nextEvent.title}. Eventets lokale tidszone er ${nextEvent.timezone}.`}>
      <span class="countdown-label">VI SES OM · {nextEvent.city.toUpperCase()}</span><strong data-countdown-value><span>—</span><span aria-hidden="true">:</span><span>—</span><span aria-hidden="true">:</span><span>—</span></strong><span class="countdown-units">DAGE &nbsp; TIMER &nbsp; MIN.</span><span class="countdown-link">Se næste event ↗</span>
    </a> : <a class="countdown" href="/events/"><span class="countdown-label">MØD ANDRE KREATIVE</span><strong>Vi ses.</strong><span class="countdown-link">Se alle events ↗</span></a>}
  </div>
</section>

<script src="../scripts/countdown.js"></script>
