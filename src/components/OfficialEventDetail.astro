---
const {event} = Astro.props;
const past = event.status === 'past';
---
<section class="official-detail" data-official-event data-event-end={event.endAt} data-event-status={event.status}>
  <a class="back-link" href="/events/">← ALLE EVENTS</a>
  <div class="official-detail-grid"><div>
    <p class="eyebrow">{event.type.toUpperCase()} · <span data-event-status-label>{past ? 'TIDLIGERE EVENT' : 'KOMMENDE EVENT'}</span></p>
    <h1>{event.title}</h1><p class="official-description">{event.description}</p>
    <dl class="official-facts"><div><dt>Dato</dt><dd><time datetime={event.startAt}>{event.dateLabel}</time></dd></div><div><dt>Tid</dt><dd>{event.time}<br /><span>{event.timezone} · lokal tid</span></dd></div><div><dt>Sted</dt><dd>{event.location}<br />{event.address}</dd></div></dl>
    <div class="official-actions">{!past && <><a class="button" data-luma-register href={event.lumaUrl}>Tilmeld dig via Luma ↗</a><a class="button secondary" data-calendar-download href={`/kalender/${event.slug}.ics`} download>Hent kalenderfil</a></>}{past && <p class="event-ended-note">Eventet er afsluttet. Tilmelding er lukket.</p>}</div>
    <p class="luma-explanation">{past ? 'De oprindelige eventoplysninger findes hos Luma.' : 'Tilmeldingen sker hos Luma. Se pris, pladser og vilkår dér.'}</p>
    <a class="luma-source" href={event.lumaUrl}>Se {past ? 'tidligere event' : 'eventoplysninger'} på Luma ↗</a>
  </div><img class="official-cover" src={`/images/luma-${event.id}-1200.webp`} srcset={`/images/luma-${event.id}-450.webp 450w, /images/luma-${event.id}-600.webp 600w, /images/luma-${event.id}-1200.webp ${event.coverWidth}w`} sizes="(max-width:600px) calc(100vw - 48px), (max-width:1000px) 45vw, 520px" width={event.coverWidth} height={event.coverHeight} alt={`Officielt eventcover: ${event.title}`} fetchpriority="high" /></div>
</section>
<section class="official-story"><div><h2>{past ? 'Om arrangementet' : 'En ny samtale.'}</h2>{event.paragraphs.map(paragraph=><p>{paragraph}</p>)}{event.sourceNote && <p class="source-note">{event.sourceNote}</p>}<p class="source-verification">Oplysninger kontrolleret mod den officielle Luma-side den 9. november 2026.</p><a href="https://luma.com/user/kinddesign">KindDesigns officielle Luma-profil ↗</a></div>{event.program && <div><h2>Program</h2><p class="program-timezone">Alle tider er lokale: {event.timezone}.</p><ol>{event.program.map(([time,label])=><li><time>{time}</time><span>{label}</span></li>)}</ol></div>}</section>
<script src="../scripts/event-status.js"></script>

<script src="../scripts/event-return.js"></script>
